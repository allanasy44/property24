# Copy to the deployment secret store; do not commit populated credentials.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEYS=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
DJANGO_ALLOWED_HOSTS=api.your-domain.example
DJANGO_CORS_ALLOWED_ORIGINS=https://app.your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.your-domain.example

DATABASE_ENGINE=postgresql
POSTGRES_HOST=your-managed-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=property24
POSTGRES_USER=property24
POSTGRES_PASSWORD=replace-me
# Keep at 0 for ASGI; this bounded Psycopg pool is per backend process.
POSTGRES_CONN_MAX_AGE=0
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=8
POSTGRES_POOL_TIMEOUT=5

REDIS_URL=rediss://your-managed-redis-host:6379/0
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT_URL=https://your-object-storage-endpoint
OBJECT_STORAGE_REGION=your-region
OBJECT_STORAGE_BUCKET=property24-media
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.your-domain.example
OBJECT_STORAGE_QUERYSTRING_AUTH=true

IDENTITY_LOCAL_AUTO_VERIFY=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=your-smtp-host
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Property24 <no-reply@your-domain.example>
