# Twilio Verify phone sign-in (optional until activated). Keep actual values in
# backend/.env or the deployment secret manager; never ship them in the app.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Recommended: Twilio API Key credentials
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace-with-secret
# Alternative supported auth (leave API key settings empty):
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-with-secret
TWILIO_VERIFY_VALIDITY_SECONDS=600
