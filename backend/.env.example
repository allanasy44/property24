DJANGO_DEBUG=true
DJANGO_SECRET_KEYS=replace-me-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8091,http://127.0.0.1:8091,http://localhost:8092,http://127.0.0.1:8092,http://localhost:19006,http://127.0.0.1:19006

DATABASE_ENGINE=postgresql
POSTGRES_DB=property24
POSTGRES_USER=property24
POSTGRES_PASSWORD=property24
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Free real-time chat/presence. Use redis://redis:6379/0 in Docker.
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-me-with-a-long-random-jwt-secret
JWT_ACCESS_TOKEN_SECONDS=3600
JWT_REFRESH_TOKEN_SECONDS=2592000

REGISTRATION_OTP_TTL_MINUTES=10
OTP_DELIVERY_CHANNEL=email

# Free development mode prints emails in the backend terminal.
# For real inbox delivery, use Gmail SMTP with an app password or another SMTP provider.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me@example.com
EMAIL_HOST_PASSWORD=replace-me-with-an-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Property24 <no-reply@property24.local>

OTP_SMS_WEBHOOK_URL=
OTP_SMS_API_KEY=
OTP_SMS_SENDER=Property24

OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=property24-media
OBJECT_STORAGE_ACCESS_KEY_ID=property24minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=property24miniosecret
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9010/property24-media
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_QUERYSTRING_AUTH=false
OBJECT_STORAGE_UPLOAD_EXPIRY_SECONDS=900

MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

MAP_PROVIDER=openstreetmap
GOOGLE_SIGN_IN_ENABLED=false
GOOGLE_CLIENT_IDS=

AI_PROVIDER=local
AI_MODEL=property24-rules-v1
AI_ASSISTED_REVIEW_ENABLED=true

BACKEND_PORT=8010
